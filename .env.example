# Firebase Admin (server-only). The website never talks to VoteHub from the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional aliases
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# Protects POST /api/admin/sync-votehub and GET|POST /api/cron/sync-votehub
CRON_SECRET=

# Optional dedicated admin secret; falls back to CRON_SECRET
# ADMIN_SYNC_SECRET=

# Optional VoteHub overrides
# VOTEHUB_API_BASE_URL=https://api.votehub.com
# VOTEHUB_INCREMENTAL_OVERLAP_DAYS=3
