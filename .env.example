# Firebase Admin (server-only). The website never talks to VoteHub from the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional aliases
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# Client Firebase Auth (public config). Admin UI is limited to NEXT_PUBLIC_ADMIN_EMAIL.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ADMIN_EMAIL=mityabv@gmail.com

# Protects the VoteHub sync and GET|POST /api/cron/presidential-news
CRON_SECRET=

# News cards. The visitor never calls the model. Default model is gpt-5-nano.
OPENAI_API_KEY=
# OPENAI_NEWS_MODEL=gpt-5-nano

# Optional dedicated admin secret; falls back to CRON_SECRET
# ADMIN_SYNC_SECRET=

# Comma-separated IPs that can see the unpublished Russian preview, besides the built-in admin IP.
# Loopback is included automatically in development.
# ADMIN_PREVIEW_IPS=

# Optional VoteHub overrides
# VOTEHUB_API_BASE_URL=https://api.votehub.com
# VOTEHUB_INCREMENTAL_OVERLAP_DAYS=3
